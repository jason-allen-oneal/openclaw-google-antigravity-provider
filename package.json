{
  "name": "google-antigravity-provider",
  "version": "0.3.0",
  "description": "Google Antigravity CLI (agy) provider and agent runtime for OpenClaw",
  "type": "module",
  "author": "Jason Allen O'Neal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jason-allen-oneal/openclaw-google-antigravity-provider.git"
  },
  "homepage": "https://github.com/jason-allen-oneal/openclaw-google-antigravity-provider#readme",
  "bugs": {
    "url": "https://github.com/jason-allen-oneal/openclaw-google-antigravity-provider/issues"
  },
  "files": [
    "dist/**/*.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.entry.json --noEmit",
    "test": "vitest run --testTimeout=20000"
  },
  "devDependencies": {
    "openclaw": "^2026.8.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  }
}
